    {
      "name": "2. SQL Connector Admin",
      "item": [
        {
          "name": "List all databases",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/databases/all",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["databases", "all"]
            }
          }
        },
        {
          "name": "List databases for sql-03",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/databases?server=sql-03",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["databases"],
              "query": [
                {
                  "key": "server",
                  "value": "sql-03"
                }
              ]
            }
          }
        },
        {
          "name": "Get schema for sql-03/prueba_mcp",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/schema?server=sql-03&database=prueba_mcp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["schema"],
              "query": [
                {
                  "key": "server",
                  "value": "sql-03"
                },
                {
                  "key": "database",
                  "value": "prueba_mcp"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Gateway Admin Fast-Path",
      "item": [
